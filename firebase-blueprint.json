{
  "entities": {
    "SchoolSettings": {
      "title": "School Settings",
      "description": "General settings for the school, including grading scales and branding.",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "principalName": { "type": "string", "maxLength": 100 },
        "academicSession": { "type": "string", "maxLength": 50 },
        "resultCardTitle": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "number" }
      },
      "required": ["schoolName", "updatedAt"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Authorized administrator list.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "A student in the school.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 50 },
        "rollNumber": { "type": "string", "maxLength": 50 },
        "studentName": { "type": "string", "maxLength": 100 },
        "fatherName": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 50 },
        "section": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["studentId", "rollNumber", "studentName", "class", "active", "createdAt", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "An examination session.",
      "type": "object",
      "properties": {
        "examName": { "type": "string", "maxLength": 100 },
        "examCategory": { "type": "string", "maxLength": 100 },
        "academicSession": { "type": "string", "maxLength": 50 },
        "class": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Draft", "Published", "Unpublished"], "maxLength": 20 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["examName", "academicSession", "status", "createdAt", "updatedAt"]
    },
    "Result": {
      "title": "Result",
      "description": "A student's result for a specific exam.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 50 },
        "rollNumber": { "type": "string", "maxLength": 50 },
        "examId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 100 },
        "className": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Draft", "Published"], "maxLength": 20 },
        "totalMarks": { "type": "number" },
        "obtainedMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "resultStatus": { "type": "string", "maxLength": 20 },
        "position": { "type": "string", "maxLength": 20 },
        "attendance": { "type": "string", "maxLength": 20 },
        "discipline": { "type": "string", "maxLength": 20 },
        "remarks": { "type": "string", "maxLength": 500 },
        "subjects": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["studentId", "rollNumber", "examId", "status", "createdAt", "updatedAt", "subjects"]
    }
  },
  "firestore": {
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/SchoolSettings" },
      "description": "Global school settings. Typically just settings/general."
    },
    "admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "List of admin users. Document ID is the user's UID."
    },
    "students/{studentDocId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students directory."
    },
    "exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Examinations created by admin."
    },
    "results/{resultId}": {
      "schema": { "$ref": "#/entities/Result" },
      "description": "Student results."
    }
  }
}
